{
    "headers": [
        {
            "source": "/owlbear/(.*)",
            "headers": [
                { "key": "Access-Control-Allow-Origin", "value": "*" }
            ]
        }
    ],
    "rewrites": [
        {
            "source": "/((?!api/|assets/|owlbear/).*)",
            "destination": "/index.html"
        }
    ]
}
